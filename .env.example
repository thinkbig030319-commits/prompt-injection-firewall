# Copy this file to .env (or just set as an environment variable) to
# connect the /chat endpoint to a real AI model.
#
# Recommended: Gemini has a genuine free tier, no credit card required.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-key-here

# Alternative: Anthropic's Claude API (paid, no free tier).
# ANTHROPIC_API_KEY=your-key-here

# Without either set, /chat runs in "demo mode" with a canned reply.
